--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -5697,6 +5697,23 @@ out:
 	b43info(wl, "Controller restarted\n");
 }
 
+static void b43_cg3000_setup_ht_cap(struct b43_wldev *dev,
+				    struct ieee80211_supported_band *sband)
+{
+	if (!b43_cg3000_4331_board(dev))
+		return;
+
+	memset(sband->ht_cap.mcs.rx_mask, 0,
+	       sizeof(sband->ht_cap.mcs.rx_mask));
+	/*
+	 * Current b43 HTPHY TX support is reliable only at the lower single
+	 * stream MCS rates on CG3000.  Advertising the full SPROM RX chain set
+	 * lets minstrel probe MCS5/MCS7 and causes heavy retries/beacon loss.
+	 */
+	sband->ht_cap.mcs.rx_mask[0] = 0x07;
+	sband->ht_cap.mcs.tx_params = IEEE80211_HT_MCS_TX_DEFINED;
+}
+
 static int b43_setup_bands(struct b43_wldev *dev,
 			   bool have_2ghz_phy, bool have_5ghz_phy)
 {
@@ -5714,11 +5742,17 @@ static int b43_setup_bands(struct b43_wl
 		     phy->radio_rev == 9;
 
 	if (have_2ghz_phy) {
-		if (dev->phy.type == B43_PHYTYPE_HT)
+		if (dev->phy.type == B43_PHYTYPE_HT) {
 			hw->wiphy->bands[NL80211_BAND_2GHZ] = limited_2g ?
 				&b43_band_2ghz_ht_limited :
 				&b43_band_2GHz_ht;
-		else
+			/*
+			 * The static table enables one stream.  CG3000's SPROM
+			 * advertises three RX chains, but TX header support is
+			 * still limited to MCS0-7, so keep TX to one stream.
+			 */
+			b43_cg3000_setup_ht_cap(dev, hw->wiphy->bands[NL80211_BAND_2GHZ]);
+		} else
 			hw->wiphy->bands[NL80211_BAND_2GHZ] = limited_2g ?
 				&b43_band_2ghz_limited :
 				&b43_band_2GHz;
