+			b43_phy_read(dev, B43_PHY_HT_TXPCTL_TARG_PWR2),
+			b43_phy_read(dev, B43_PHY_HT_TXPCTL_IDLE_TSSI),
+			b43_phy_read(dev, B43_PHY_HT_TXPCTL_IDLE_TSSI2),
+			b43_phy_read(dev, B43_PHY_HT_TXPCTL_N),
