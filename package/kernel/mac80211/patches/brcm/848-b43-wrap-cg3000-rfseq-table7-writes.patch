+#define B43_PHY_HT_RFSEQ_TABLE7_CTL_OLD		0x44b
+#define B43_PHY_HT_RFSEQ_TABLE7_CTL_OLD_ENABLE	0x0008
+#define B43_PHY_HT_RFSEQ_TABLE7_CTL_REV4	0x450
+#define B43_PHY_HT_RFSEQ_TABLE7_CTL_REV4_ENABLE	0x0001
+
+static u16 b43_phy_ht_cg3000_rfseq_table7_begin_write(struct b43_wldev *dev,
+						      u16 *ctl_reg)
+{
+	u16 saved;
+	u16 enable;
+
+	/*
+	 * eCos MCP_iHtPhyWriteTableWithRfSeqSave wraps only RFSEQ table 7
+	 * writes.  On PHY rev < 4 it saves PHY 0x44b and sets bit 0x0008;
+	 * on PHY rev >= 4 it saves PHY 0x450 and sets bit 0x0001.
+	 */
+	if (dev->phy.rev >= 4) {
+		*ctl_reg = B43_PHY_HT_RFSEQ_TABLE7_CTL_REV4;
+		enable = B43_PHY_HT_RFSEQ_TABLE7_CTL_REV4_ENABLE;
+	} else {
+		*ctl_reg = B43_PHY_HT_RFSEQ_TABLE7_CTL_OLD;
+		enable = B43_PHY_HT_RFSEQ_TABLE7_CTL_OLD_ENABLE;
+	}
+
+	saved = b43_phy_ht_cg3000_phy_read_direct(dev, *ctl_reg);
+	b43_phy_ht_cg3000_phy_write_direct(dev, *ctl_reg, saved | enable);
+
+	return saved;
+}
+
+static void b43_phy_ht_cg3000_rfseq_table7_end_write(struct b43_wldev *dev,
+						     u16 ctl_reg, u16 saved)
+{
+	b43_phy_ht_cg3000_phy_write_direct(dev, ctl_reg, saved);
+}
