+#define B43_MIMO_PLCP_MCS_MASK		0x7f
+#define B43_MIMO_PLCP_40MHZ		0x80
+#define B43_MIMO_PLCP3_SHORT_GI		0x80
+
+static int b43_plcp_get_bitrate_idx_mcs(struct b43_plcp_hdr6 *plcp)
+{
+	int mcs = plcp->raw[0] & B43_MIMO_PLCP_MCS_MASK;
+
+	if (mcs > 31)
+		return -1;
+	return mcs;
+}
