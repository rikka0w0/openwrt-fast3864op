+	 * TX power index.
+	 */
+	for (i = 0; i < ARRAY_SIZE(ecos_2g_gain_table); i++) {
+		const u8 *entry = ecos_2g_gain_table[i];
+		u32 value = (0xff << 24) | (entry[2] << 16) |
+			    (entry[1] << 8) | entry[0];
+
+		b43_phy_ht_cg3000_rfseq_tab_write32(dev, 7, 192 + i, value);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(ecos_2g_gain_table); i++) {
+		const u8 *entry = ecos_2g_gain_table[i];
+		u32 value = b43_phy_ht_cg3000_rfseq_tab_read32(dev, 7, 320 + i);
+
+		value = (value & 0x000fffff) | (entry[3] << 28) |
+			(entry[4] << 20);
+		b43_phy_ht_cg3000_rfseq_tab_write32(dev, 7, 320 + i, value);
+	}
