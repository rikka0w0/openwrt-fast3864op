+static u32 b43_phy_ht_cg3000_rfseq_tab_read32(struct b43_wldev *dev,
+					      unsigned int table_id,
+					      unsigned int offset)
+{
+	b43_phy_ht_cg3000_phy_write_direct(dev, B43_PHY_HT_RFSEQ_TABLE_ADDR,
+					   (table_id << 10) | offset);
+	return b43_phy_ht_cg3000_phy_read_direct(dev,
+						 B43_PHY_HT_RFSEQ_TABLE_DATALO) |
+	       b43_phy_ht_cg3000_phy_read_direct(dev,
+						 B43_PHY_HT_RFSEQ_TABLE_DATAHI) << 16;
+}
+
+static void b43_phy_ht_cg3000_rfseq_tab_write32(struct b43_wldev *dev,
+						unsigned int table_id,
+						unsigned int offset, u32 value)
+{
+	b43_phy_ht_cg3000_phy_write_direct(dev, B43_PHY_HT_RFSEQ_TABLE_ADDR,
+					   (table_id << 10) | offset);
+	b43_phy_ht_cg3000_phy_write_direct(dev, B43_PHY_HT_RFSEQ_TABLE_DATAHI,
+					   value >> 16);
+	b43_phy_ht_cg3000_phy_write_direct(dev, B43_PHY_HT_RFSEQ_TABLE_DATALO,
+					   value);
+	dev->phy.writes_counter = 0;
+}
