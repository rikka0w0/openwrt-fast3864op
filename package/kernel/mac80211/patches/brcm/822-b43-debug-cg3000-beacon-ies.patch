+static void b43_cg3000_dump_beacon_ies(struct b43_wldev *dev,
+					const struct sk_buff *skb,
+					size_t checked_len,
+					const char *where)
+{
+	const size_t variable = offsetof(struct ieee80211_mgmt,
+					 u.beacon.variable);
+	const u8 *ie;
+	bool ht_cap = false, ht_oper = false, wmm = false, tim = false;
+	size_t rem;
+	static unsigned int logs;
+
+	if (!b43_cg3000_4331_board(dev) || logs >= 16)
+		return;
+
+	if (skb->len < variable)
+		return;
+
+	checked_len = min_t(size_t, checked_len, skb->len);
+	if (checked_len < variable)
+		return;
+
+	ie = skb->data + variable;
+	rem = checked_len - variable;
+	while (rem >= 2) {
+		u8 id = ie[0];
+		u8 len = ie[1];
+
+		if (len > rem - 2)
+			break;
+		ht_cap |= id == WLAN_EID_HT_CAPABILITY;
+		ht_oper |= id == WLAN_EID_HT_OPERATION;
+		tim |= id == WLAN_EID_TIM;
+		wmm |= id == WLAN_EID_VENDOR_SPECIFIC && len >= 4 &&
+		       ie[2] == 0x00 && ie[3] == 0x50 && ie[4] == 0xf2;
+		ie += len + 2;
+		rem -= len + 2;
+	}
+	b43info(dev->wl, "CG3000 beacon %s: skb_len=%zu checked=%zu ht_cap=%d ht_oper=%d tim=%d wmm=%d\n",
+		where, skb->len, checked_len, ht_cap, ht_oper, tim, wmm);
+	logs++;
+}
+
