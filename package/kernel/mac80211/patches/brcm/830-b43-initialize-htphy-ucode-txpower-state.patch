+static void b43_phy_ht_update_ucode_txpower(struct b43_wldev *dev,
+					    const u8 target[3])
+{
+	u8 target_min = min(target[0], target[1]);
+	u16 target_shm;
+
+	if (!b43_cg3000_4331_board(dev))
+		return;
+
+	target_min = min(target_min, target[2]);
+	target_shm = target_min << 4;
+
+	/*
+	 * brcmsmac writes these shared-memory fields when hardware TX power
+	 * control is enabled.  The HTPHY register setup below enables the
+	 * hardware controller, so mirror the ucode-facing state as well.
+	 */
+	b43_shm_write16(dev, B43_SHM_SHARED, B43_SHM_SH_TXPWR_MAX, 63);
+	b43_shm_write16(dev, B43_SHM_SHARED, B43_SHM_SH_TXPWR_N, 16);
+	b43_shm_write16(dev, B43_SHM_SHARED, B43_SHM_SH_TXPWR_TARGET,
+			target_shm);
+	b43_shm_write16(dev, B43_SHM_SHARED, B43_SHM_SH_TXPWR_CUR,
+			target_shm);
+}
