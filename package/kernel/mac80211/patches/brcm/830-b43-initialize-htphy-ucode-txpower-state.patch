 #define B43_SHM_SH_PRTLEN		0x004A	/* Probe Response template length */
 #define B43_SHM_SH_PRMAXTIME		0x0074	/* Probe Response max time */
+#define B43_SHM_SH_TXPWR_N		0x0024	/* Hardware power-control TSSI sample count */
+#define B43_SHM_SH_TXPWR_TARGET		0x0026	/* Hardware power-control target power */
+#define B43_SHM_SH_TXPWR_MAX		0x0028	/* Hardware power-control maximum offset */
