@@ -1772,6 +1777,19 @@ u16 b43_tx_antenna_phy_ctl(struct b43_wl
 	return (txchain << 6) & B43_TXH_PHY_ANT;
 }
 
+u16 b43_cg3000_txpwr_phy_ctl(struct b43_wldev *dev)
+{
+	int txpwr = b43_modparam_cg3000_txpwr_phyctl;
+
+	if (!b43_cg3000_4331_board(dev))
+		return B43_TXH_PHY_TXPWR;
+	if (txpwr < 0)
+		txpwr = B43_TXH_PHY_TXPWR >> B43_TXH_PHY_TXPWR_SHIFT;
+
+	return (txpwr & (B43_TXH_PHY_TXPWR >> B43_TXH_PHY_TXPWR_SHIFT)) <<
+	       B43_TXH_PHY_TXPWR_SHIFT;
+}
