+int b43_modparam_cg3000_txpwr_phyctl = -1;
+module_param_named(cg3000_txpwr_phyctl, b43_modparam_cg3000_txpwr_phyctl, int, 0644);
+MODULE_PARM_DESC(cg3000_txpwr_phyctl,
