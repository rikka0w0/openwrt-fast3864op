+static const u8 b43_mcs_phy_ctl3[8] = {
+	0x00, 0x08, 0x0a, 0x10, 0x12, 0x19, 0x1a, 0x1c,
+};
+
+static const u8 b43_mcs_legacy_ofdm_rate[8] = {
+	B43_OFDM_RATE_6MB, B43_OFDM_RATE_12MB, B43_OFDM_RATE_18MB,
+	B43_OFDM_RATE_24MB, B43_OFDM_RATE_36MB, B43_OFDM_RATE_48MB,
+	B43_OFDM_RATE_54MB, B43_OFDM_RATE_54MB,
+};
+
+static const u16 b43_mcs_20_kbps[8] = {
+	6500, 13000, 19500, 26000, 39000, 52000, 58500, 65000,
+};
+
+static bool b43_tx_rate_is_mcs(const struct ieee80211_tx_rate *rate)
+{
+	return rate->idx >= 0 &&
+	       rate->idx < ARRAY_SIZE(b43_mcs_phy_ctl3) &&
+	       rate->flags & IEEE80211_TX_RC_MCS;
+}
+
+static u8 b43_tx_rate_mcs(const struct ieee80211_tx_rate *rate)
+{
+	if (!b43_tx_rate_is_mcs(rate))
+		return 0;
+
+	return rate->idx;
+}
+
+static void b43_generate_mimo_plcp_hdr(struct b43_plcp_hdr6 *plcp,
+				       u16 octets, u8 mcs)
+{
+	u8 *raw = plcp->raw;
+
+	memset(raw, 0, sizeof(plcp->raw));
+	raw[0] = mcs & 0x7f;
+	raw[1] = octets & 0xff;
+	raw[2] = octets >> 8;
+	raw[3] = 0x07;
+}
+
+static u16 b43_mimo_lsig_len(u16 octets, u8 mcs)
+{
+	u32 nsyms;
+	u32 kndps;
+
+	if (mcs >= ARRAY_SIZE(b43_mcs_20_kbps))
+		mcs = 0;
+
+	kndps = b43_mcs_20_kbps[mcs] * 4;
+	nsyms = DIV_ROUND_UP((16 + 8 * octets + 6) * 1000, kndps);
+	nsyms += 4;
+
+	return 3 * nsyms - 3;
+}
