--- a/drivers/net/wireless/broadcom/b43/b43.h
+++ b/drivers/net/wireless/broadcom/b43/b43.h
@@ -391 +391,4 @@
 #define B43_HF_PR45960W		0x080000000000ULL /* PR 45960 workaround (rev >= 13 only) */
+#define B43_HF4_EXTPA_ENABLE	0x4000 /* External PA present */
+#define B43_HF5_4313_GPIOCTRL	0x0001 /* BCM4313/4331 ucode GPIO control */
+
--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -5126,7 +5126,26 @@ static int b43_wireless_core_init(struct
 		    dev->dev->sdev->bus->pcicore.dev->id.revision <= 10)
 			hf |= B43_HF_PCISCW; /* PCI slow clock workaround. */
 #endif
 	hf &= ~B43_HF_SKCFPUP;
+	if (b43_cg3000_4331_board(dev)) {
+		u16 hostf4, hostf5;
+
+		/*
+		 * The BCM4331/BCM4332 HTPHY code enables hardware TX power
+		 * control in PHY registers. Mirror brcmsmac's ucode-facing
+		 * host flags so the firmware also knows hardware power
+		 * control, external PA and ucode GPIO control paths are
+		 * enabled.
+		 */
+		hf |= B43_HF_HWPCTL;
+		hostf4 = b43_shm_read16(dev, B43_SHM_SHARED, B43_SHM_SH_HOSTF4);
+		hostf4 |= B43_HF4_EXTPA_ENABLE;
+		b43_shm_write16(dev, B43_SHM_SHARED, B43_SHM_SH_HOSTF4, hostf4);
+		hostf5 = b43_shm_read16(dev, B43_SHM_SHARED, B43_SHM_SH_HOSTF5);
+		hostf5 |= B43_HF5_4313_GPIOCTRL;
+		b43_shm_write16(dev, B43_SHM_SHARED, B43_SHM_SH_HOSTF5, hostf5);
+	}
+
	b43_hf_write(dev, hf);
 
 	/* tell the ucode MAC capabilities */
