--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -4335,12 +4335,29 @@ static void b43_op_bss_info_changed(stru
 		}
 
 	if (b43_status(dev) >= B43_STAT_INITIALIZED) {
-		if (changed & BSS_CHANGED_BEACON &&
-		    (b43_is_mode(wl, NL80211_IFTYPE_AP) ||
-		     b43_is_mode(wl, NL80211_IFTYPE_MESH_POINT) ||
-		     b43_is_mode(wl, NL80211_IFTYPE_ADHOC)))
-			b43_update_templates(wl);
+		bool beaconing_mode = b43_is_mode(wl, NL80211_IFTYPE_AP) ||
+				      b43_is_mode(wl, NL80211_IFTYPE_MESH_POINT) ||
+				      b43_is_mode(wl, NL80211_IFTYPE_ADHOC);
 
+		if ((changed & (BSS_CHANGED_BEACON |
+				BSS_CHANGED_BEACON_ENABLED)) && beaconing_mode) {
+			if (!(changed & BSS_CHANGED_BEACON_ENABLED) ||
+			    conf->enable_beacon) {
+				b43_update_templates(wl);
+				dev->irq_mask |= B43_IRQ_BEACON_TX_OK |
+						 B43_IRQ_BEACON_CANCEL;
+				if (b43_read32(dev, B43_MMIO_GEN_IRQ_MASK))
+					b43_write32(dev, B43_MMIO_GEN_IRQ_MASK,
+						    dev->irq_mask);
+			} else {
+				u32 cmd = b43_read32(dev, B43_MMIO_MACCMD);
+
+				cmd &= ~(B43_MACCMD_BEACON0_VALID |
+					 B43_MACCMD_BEACON1_VALID);
+				b43_write32(dev, B43_MMIO_MACCMD, cmd);
+				wl->beacon_templates_virgin = true;
+			}
+		}
 		if (changed & BSS_CHANGED_BSSID)
 			b43_write_mac_bssid_templates(dev);
 	}
