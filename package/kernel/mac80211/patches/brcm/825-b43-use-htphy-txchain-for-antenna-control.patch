--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -1710,6 +1710,33 @@
 	return 0;
 }
 
+static u16 b43_tx_antenna_to_phyctl(struct b43_wldev *dev, int antenna)
+{
+	u8 txchain;
+
+	if (dev->phy.type != B43_PHYTYPE_HT)
+		return b43_antenna_to_phyctl(antenna);
+
+	switch (antenna) {
+	case B43_ANTENNA0:
+		return 1 << 6;
+	case B43_ANTENNA1:
+		return 2 << 6;
+	case B43_ANTENNA2:
+		return 4 << 6;
+	case B43_ANTENNA3:
+		return 8 << 6;
+	}
+
+	txchain = dev->dev->bus_sprom->txchain & 0xf;
+	if (!txchain)
+		txchain = dev->dev->bus_sprom->ant_available_bg & 0xf;
+	if (!txchain)
+		return B43_TXH_PHY_ANT01AUTO;
+
+	return (txchain << 6) & B43_TXH_PHY_ANT;
+}
