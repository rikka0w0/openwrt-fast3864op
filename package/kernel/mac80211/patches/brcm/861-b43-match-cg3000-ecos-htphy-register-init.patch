+static void b43_phy_ht_cg3000_apply_register_tables(struct b43_wldev *dev)
+{
+	static const u16 reg_0x2ca_values[] = {
+		0xfe98, 0x00a4, 0xfe88, 0x00a4, 0xfa03,
+		0x0240, 0x0134, 0xfec6, 0x0134, 0x0079,
+		0xffb7, 0x0079, 0x005b, 0x007c, 0x005b,
+	};
+	static const u16 reg_0x195_values[] = {
+		0xffb3, 0x0014, 0xff9e, 0x0031, 0xffa3,
+		0x003c, 0x0038, 0x006f, 0x0038, 0x001a,
+		0xfffb, 0x001a, 0x0022, 0xffe0, 0x0022,
+	};
+	static const u16 reg_0x186_values[] = {
+		0xfed9, 0x00c8, 0xfe95, 0x008e, 0xfa91,
+		0x033a, 0x0097, 0x012d, 0x0097, 0x0097,
+		0x012d, 0x0097, 0x025a, 0xfd10, 0x025a,
+	};
+	unsigned int i;
+
+	if (!b43_cg3000_4331_board(dev))
+		return;
+
+	if (b43_current_band(dev->wl) != NL80211_BAND_2GHZ)
+		return;
+
+	/*
+	 * eCos MCP_iHtPhyProgramRxGainOffsetTables writes three 15-entry
+	 * raw HTPHY register tables during BCM4331/BCM4332 HTPHY init.
+	 * The final 0x186 table is the forced mode-table path selected by
+	 * MCP_iHtPhyProgramRxGainOffsetModeTable when the stored mode is zero,
+	 * which is the cold-init state observed for this board.
+	 */
+	for (i = 0; i < ARRAY_SIZE(reg_0x2ca_values); i++)
+		b43_phy_write(dev, 0x02ca + i, reg_0x2ca_values[i]);
+	for (i = 0; i < ARRAY_SIZE(reg_0x195_values); i++)
+		b43_phy_write(dev, 0x0195 + i, reg_0x195_values[i]);
+	for (i = 0; i < ARRAY_SIZE(reg_0x186_values); i++)
+		b43_phy_write(dev, 0x0186 + i, reg_0x186_values[i]);
+
+	b43_phy_set(dev, 0x0217, 0x0040);
+	b43info(dev->wl, "CG3000 HTPHY eCos register tables applied\n");
+}
+
+static void b43_phy_ht_cg3000_apply_ecos_afe_init(struct b43_wldev *dev)
+{
+	static const u16 core_afe_ctrl_regs[] = { 0x0910, 0x0914, 0x0918 };
+	static const u16 core_afe_aux_regs[] = { 0x0911, 0x0915, 0x0919 };
+	static const u16 core_tx_regs[] = { 0x0404, 0x0444, 0x0484 };
+	static const u16 tbl8_offset11_values[] = { 0x0084, 0x0080, 0x0084 };
+	static const u16 tbl8_offset15_values[] = { 0x0001, 0x0002, 0x0001 };
+	unsigned int core;
+
+	if (!b43_cg3000_4331_board(dev))
+		return;
+
+	if (b43_current_band(dev->wl) != NL80211_BAND_2GHZ)
+		return;
+
+	/*
+	 * eCos sub_80A31070 initializes the BCM4331/BCM4332 HTPHY AFE path
+	 * before TX power control is configured.  Most table 7 writes already
+	 * exist in b43; this block mirrors the per-core table 8 and raw PHY
+	 * writes that were missing from the upstream HTPHY init.
+	 */
+	for (core = 0; core < 3; core++) {
+		unsigned int base = core * 16;
+
+		b43_phy_set(dev, core_afe_aux_regs[core], 0x0004);
+		b43_phy_set(dev, core_afe_ctrl_regs[core], 0x0004);
+		b43_phy_mask(dev, core_afe_aux_regs[core], ~0x0001);
+		b43_phy_set(dev, core_afe_ctrl_regs[core], 0x0001);
+		b43_httab_write(dev, B43_HTTAB16(8, base + 4),
+				(u16)-928);
+		b43_httab_write(dev, B43_HTTAB16(8, base + 5), 0x000c);
+		b43_phy_mask(dev, core_afe_ctrl_regs[core], ~0x0004);
+		b43_httab_write(dev, B43_HTTAB16(8, base + 11),
+				tbl8_offset11_values[core]);
+		b43_httab_write(dev, B43_HTTAB16(8, base + 15),
+				tbl8_offset15_values[core]);
+	}
+
+	b43_phy_set(dev, 0x0185, 0x0008);
+	b43_phy_set(dev, 0x0035, 0x0002);
+	b43_phy_mask(dev, 0x01dd, ~0x0020);
+	b43_phy_maskset(dev, 0x01db, ~0x00ff, 0x0055);
+	b43_phy_mask(dev, 0x01d9, ~0x0020);
+	b43_phy_maskset(dev, 0x01d7, ~0x00ff, 0x0055);
+	b43_phy_write(dev, 0x006a, 0x0002);
+	b43_phy_maskset(dev, 0x0324, ~0x3f00, 0x0f00);
+	for (core = 0; core < 3; core++)
+		b43_phy_set(dev, core_tx_regs[core], 0x2000);
+
+	b43info(dev->wl, "CG3000 HTPHY eCos AFE init applied\n");
+}
+
+static void b43_phy_ht_cg3000_apply_radio159(struct b43_wldev *dev)
+{
+	unsigned int core;
+
+	if (!b43_cg3000_4331_board(dev))
+		return;
+
+	if (b43_current_band(dev->wl) != NL80211_BAND_2GHZ)
+		return;
+
+	for (core = 0; core < 3; core++) {
+		b43_phy_set(dev, 0x08bf, 0x0001);
+		b43_radio_write(dev, (core << 10) | 0x0159, 0x0011);
+	}
+}
